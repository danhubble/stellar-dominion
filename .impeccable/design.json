  "narrative": {
    "northStar": "The Command Console",
    "overview": "Stellar Dominion looks like the instrument panel of a ship: dark panels over a live starfield, painted planets, and controls that feel like physical keys. Every paid action is a raised slab whose colour is its currency, and meaningful moments confirm themselves by typing a status word behind a blinking cursor.",
    "keyCharacteristics": [
      "Deep-space navy base with a faint violet and cyan glow",
      "Solid slab buttons for every purchase; fill colour is the currency",
      "Monospace numerals; labels at 11px and up",
      "Colour as signal, never decoration",
      "Phone-first: 390x667 and 390x844, 44px taps"
    ],
    "rules": [
      {
        "name": "The Signal Rule",
        "body": "Cyan act/ore, violet crystal/Nexus, gold reward, bronze salvage, green good/done, rose danger/enemy. Use Silver Steel for identity.",
        "section": "colors"
      },
      {
        "name": "The Enemy Is Red Rule",
        "body": "Anything hostile is rose regardless of faction; faction colours are for names only.",
        "section": "colors"
      },
      {
        "name": "The Kind Tint Rule",
        "body": "A held system row takes its kind colour as a wash, border and inset bar.",
        "section": "colors"
      },
      {
        "name": "The 11px Floor Rule",
        "body": "Nothing the player reads is smaller than 11px.",
        "section": "typography"
      },
      {
        "name": "The Numbers Are Mono Rule",
        "body": "Every quantity the player might compare is monospace.",
        "section": "typography"
      },
      {
        "name": "The Glow Is Status Rule",
        "body": "A glow means ready, active or waiting; resting controls do not glow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do make every paid action a slab in its currency's colour, with a verb and the amount.",
      "Do say NEED X (or the honest reason) instead of fading a button.",
      "Do keep text at 11px+, contrast 4.5:1 and taps 44px, checked at 390x667 and 390x844.",
      "Do confirm meaningful actions with a typed status word.",
      "Do protect the player from selling what they need.",
      "Do honour prefers-reduced-motion."
    ],
    "donts": [
      "Don't go cartoony or bright mobile-game.",
      "Don't use a signal colour to tell things apart; use Silver Steel.",
      "Don't colour enemies by faction; enemies are rose.",
      "Don't fade whole locked cards; dim the frame, keep text readable, use a drawn lock.",
      "Don't hint at the VEGA twist; the ??? node reveals nothing.",
      "Don't add ambient glow to resting controls."
    ]
  }
}